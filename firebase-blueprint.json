        },
        "targetPricePerGram": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "maxLength": 16,
          "enum": ["active", "notified", "cancelled"]
        },
        "notes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "customerId",
        "customerName",
        "customerPhone",
        "karat",
        "alertType",
        "targetPricePerGram",
        "status",
        "notes",
        "createdAt",
        "updatedAt"
      ]
    },
    "GoldTransaction": {
      "title": "GoldTransaction",
