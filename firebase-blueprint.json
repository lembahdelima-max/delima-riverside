  },
  "firestore": {
    "/storeSettings/{ownerId}": {
      "schema": "StoreSetting",
      "description": "Per-owner global store pricing configuration."
    },
    "/branches/{branchId}": {
      "schema": "Branch",
      "description": "Physical store branches owned by the authenticated merchant."
    },
    "/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Gold jewelry and bullion inventory items across branches."
    },
    "/customers/{customerId}": {
      "schema": "Customer",
      "description": "Loyal customers containing owner-isolated PII."
    },
    "/priceAlerts/{alertId}": {
      "schema": "PriceAlert",
      "description": "Customer gold target price notification rules."
    },
    "/transactions/{txId}": {
      "schema": "GoldTransaction",
      "description": "Immutable gold sale and buyback financial records."
    },
    "/stockTransfers/{transferId}": {
      "schema": "StockTransfer",
      "description": "Atomic inter-branch stock movement audit logs."
    }
  }
}
