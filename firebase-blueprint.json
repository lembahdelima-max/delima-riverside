        "branchName",
        "invoiceNumber",
        "txType",
        "customerId",
        "customerName",
        "customerHasNpwp",
        "inventoryItemId",
        "sku",
        "itemName",
        "category",
        "karat",
        "purityPercent",
        "weightGrams",
